# Copy this file to .env.local for local development, and set the same
# variables in your Vercel project's Environment Variables for production.
# See README.md for step-by-step instructions on where each value comes from.

# The public URL this app is served from (no trailing slash).
# Local dev: http://localhost:3000
# Production: https://your-project.vercel.app
APP_BASE_URL=

# From Google Cloud Console > APIs & Services > Credentials (OAuth client ID).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres connection string (Neon, Vercel Postgres/Storage, or any Postgres).
DATABASE_URL=

# Random secret used to sign the PIN-unlock session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Random 32-byte key (base64) used to encrypt the Google refresh token at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# The PIN you'll type to unlock the app on any device. Digits only, 4-8 recommended.
APP_PIN=

# Optional: email address to notify (via your own Gmail account) when the PIN
# gets locked out after 5 wrong attempts. Leave blank to disable.
ALERT_EMAIL=
